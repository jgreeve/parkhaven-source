<Window x:Class="ParkHaven.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ParkHaven Studio" Width="1280" Height="820"
        MinWidth="900" MinHeight="620" Background="#ECEFE9">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#163A3B" Padding="12,7">
      <TextBlock x:Name="BackendBadge" AutomationProperties.AutomationId="BackendBadge"
                 Text="Backend: starten..." Foreground="White" />
    </Border>
    <TabControl x:Name="ShellTabs" Background="#ECEFE9">
      <TabItem Header="Werkruimte" AutomationProperties.AutomationId="WorkspaceTab">
       <Grid>
        <wv2:WebView2 x:Name="AppView" />
        <Border x:Name="FailurePanel" Background="#163A3B">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <TextBlock x:Name="FailureTitle" Text="ParkHaven wordt gestart" Foreground="White" FontSize="30" />
        <TextBlock x:Name="FailureMessage" Margin="0,16,0,0" Foreground="#C7DCD4"
                   AutomationProperties.AutomationId="StartupMessage" TextWrapping="Wrap" FontSize="14" />
        <Button x:Name="RetryStartup" Content="Opnieuw proberen" Click="OnRetryStartup"
                AutomationProperties.AutomationId="RetryStartup" Visibility="Collapsed"
                HorizontalAlignment="Left" Margin="0,20,0,0" Padding="16,10" />
      </StackPanel>
        </Border>
       </Grid>
      </TabItem>
      <TabItem Header="Developer" AutomationProperties.AutomationId="DeveloperTab">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="75" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="90" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Developer · backend en voortgang" FontSize="23" Foreground="#163A3B" />
            <TextBlock Text="Dit paneel blijft beschikbaar als de backend stopt. Automatische controle iedere 2 seconden."
                       TextWrapping="Wrap" Margin="0,4,0,10" />
            <WrapPanel>
              <Button Content="Nu vernieuwen" Click="OnRefreshDiagnostics" Padding="10,5" Margin="0,0,8,0" />
              <Button Content="Diagnostiek kopiëren" Click="OnCopyDiagnostics" Padding="10,5" Margin="0,0,8,0" />
              <Button Content="Logmap openen" Click="OnOpenLogDirectory" Padding="10,5" />
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,10,0,8">
            <TextBlock x:Name="DeveloperBackendStatus" AutomationProperties.AutomationId="DeveloperBackendStatus"
                       Text="Backend wordt gestart..." FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="DeveloperProcess" AutomationProperties.AutomationId="DeveloperProcess" TextWrapping="Wrap" />
            <TextBlock x:Name="DeveloperHeartbeat" AutomationProperties.AutomationId="DeveloperHeartbeat" TextWrapping="Wrap" />
            <TextBlock x:Name="DeveloperLogPath" TextWrapping="Wrap" />
            <TextBlock x:Name="DeveloperNotice" AutomationProperties.AutomationId="DeveloperNotice" TextWrapping="Wrap" Foreground="#8B3E1F" />
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock x:Name="DeveloperRunSummary" AutomationProperties.AutomationId="DeveloperRunSummary" Text="Analyses laden..." FontWeight="SemiBold" />
            <ProgressBar x:Name="AnalysisActivity" Height="4" Margin="0,4,0,4" IsIndeterminate="False" />
            <TextBlock Text="Laatste 20 runs. Fase en tijd sinds wijziging; geen geschat voltooiingspercentage. Rhino PID is geen live responscontrole."
                       TextWrapping="Wrap" FontSize="11" />
          </StackPanel>
          <DataGrid x:Name="DeveloperRuns" Grid.Row="3" AutomationProperties.AutomationId="DeveloperRuns"
                    IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                    SelectionChanged="OnRunDiagnosticSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*" />
              <DataGridTextColumn Header="Fase" Binding="{Binding Stage}" Width="180" />
              <DataGridTextColumn Header="Rhino PID" Binding="{Binding RhinoProcessId}" Width="85" />
              <DataGridTextColumn Header="Laatste wijziging" Binding="{Binding UpdatedLabel}" Width="155" />
              <DataGridTextColumn Header="Tijd in fase" Binding="{Binding PhaseAge}" Width="95" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="4" Text="Geselecteerde run · fouten en waarschuwingen" Margin="0,8,0,4" FontWeight="SemiBold" />
          <TextBox x:Name="DeveloperRunDetails" Grid.Row="5" AutomationProperties.AutomationId="DeveloperRunDetails"
                   IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                   Text="Selecteer een run om details te bekijken." />
          <TextBlock Grid.Row="6" Text="Backendlog · laatste 200 regels (blijft zichtbaar na afsluiten van de backend)" Margin="0,8,0,4" FontWeight="SemiBold" />
          <TextBox x:Name="DeveloperLog" Grid.Row="7" AutomationProperties.AutomationId="DeveloperLog"
                   IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
