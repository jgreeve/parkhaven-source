<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RhinoInstallDir Condition="'$(RhinoInstallDir)' == ''">C:\Program Files\Rhino 8</RhinoInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../rhino-plugin/AnalysisJob.cs" Link="AnalysisJob.cs" />
    <Reference Include="RhinoCommon" HintPath="$(RhinoInstallDir)\System\RhinoCommon.dll" />
  </ItemGroup>
</Project>
